# Alamat HTTP aplikasi. APP_HOST memiliki default 127.0.0.1, APP_PORT wajib diisi.
APP_HOST=127.0.0.1
APP_PORT=3001

# Gunakan false untuk HTTP lokal; gunakan true apabila aplikasi hanya diakses lewat HTTPS.
SESSION_COOKIE_SECURE=false

# Kredensial PostgreSQL yang database-nya telah dibuat sebelumnya.
DB_HOST=127.0.0.1
DB_PORT=5434
DB_NAME=toko_laptop_app
DB_USER=toko_laptop_app_user
DB_PASSWORD=replace-with-your-database-password

# Akun latihan yang dibuat atau diperbarui setiap aplikasi dinyalakan.
# Jangan gunakan password akun nyata: proyek ini menyimpannya sebagai teks biasa untuk pembelajaran.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
