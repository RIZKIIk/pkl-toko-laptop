// Akun aplikasi; role menentukan izin admin, buyer, atau restocker.
Table public.users {
  id bigint [pk, increment]
  username varchar(100) [not null, unique]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  password_hash text [not null]
  role varchar(20) [not null, default: 'buyer']

  checks {
    `length(btrim(username)) > 0` [name: 'users_username_check']
    `role in ('admin', 'buyer', 'restocker')` [name: 'users_role_check']
  }
}

// Inventaris laptop. Nilai stok dan harga divalidasi agar tidak negatif.
Table public.laptops {
  id bigint [pk, increment]
  nama varchar(150) [not null]
  merek varchar(100) [not null]
  deskripsi text [not null, default: '']
  harga bigint [not null]
  stok integer [not null]
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  checks {
    `length(btrim(nama)) > 0` [name: 'laptops_nama_check']
    `length(btrim(merek)) > 0` [name: 'laptops_merek_check']
    `harga >= 0` [name: 'laptops_harga_check']
    `stok >= 0` [name: 'laptops_stok_check']
  }
}

// Diisi otomatis oleh trigger laptops_capture_audit_log untuk INSERT/UPDATE/DELETE.
Table public.laptop_logs {
  id bigint [pk, increment]
  // FK opsional supaya catatan log tetap ada setelah laptop/user dihapus.
  laptop_id bigint [null]
  operation varchar(10) [not null]
  old_data jsonb
  new_data jsonb
  changed_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]
  user_id bigint [null]

  indexes {
    (laptop_id) [name: 'laptop_logs_laptop_id_idx']
    (user_id) [name: 'laptop_logs_user_id_idx']
  }

  checks {
    `operation in ('INSERT', 'UPDATE', 'DELETE')` [name: 'laptop_logs_operation_check']
  }
}

// Struk pembelian simulasi menyimpan snapshot agar tetap dapat dicetak jika produk berubah.
Table public.purchases {
  id bigint [pk, increment]
  user_id bigint [null]
  username varchar(100) [not null]
  laptop_id bigint [null]
  laptop_name varchar(150) [not null]
  laptop_brand varchar(100) [not null]
  unit_price bigint [not null]
  quantity integer [not null]
  total_price bigint [not null]
  payment_method varchar(24) [not null]
  payment_status varchar(24) [not null, default: 'simulated_paid']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (user_id) [name: 'purchases_user_id_idx']
    (laptop_id) [name: 'purchases_laptop_id_idx']
    (created_at [desc]) [name: 'purchases_created_at_idx']
  }

  checks {
    `unit_price >= 0` [name: 'purchases_unit_price_check']
    `quantity > 0` [name: 'purchases_quantity_check']
    `total_price >= 0` [name: 'purchases_total_price_check']
    `total_price = unit_price * quantity` [name: 'purchases_total_matches_check']
    `payment_method in ('qris', 'cash', 'bank_transfer', 'debit_card')` [name: 'purchases_payment_method_check']
    `payment_status in ('simulated_paid')` [name: 'purchases_payment_status_check']
  }
}

Ref laptop_logs_user_id_fkey: public.users.id < public.laptop_logs.user_id [delete: set null]
Ref laptop_logs_laptop_id_fkey: public.laptops.id < public.laptop_logs.laptop_id [delete: set null]
Ref purchases_user_id_fkey: public.users.id < public.purchases.user_id [delete: set null]
Ref purchases_laptop_id_fkey: public.laptops.id < public.purchases.laptop_id [delete: set null]
