{
  "info": {
    "name": "Toko Laptop App - API",
    "description": "Coba registrasi dan login sebagai admin atau buyer, lalu gunakan endpoint inventaris dan pembelian laptop.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3001",
      "type": "string"
    },
    {
      "key": "laptopId",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminUsername",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "registerUsername",
      "value": "pengguna-baru",
      "type": "string"
    },
    {
      "key": "registerPassword",
      "value": "password-lokal",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "buyerToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "00 - Register akun",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{registerUsername}}\",\"password\":\"{{registerPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "01 - Login admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{adminUsername}}\",\"password\":\"{{adminPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "02 - Daftar laptop",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/laptops"
      }
    },
    {
      "name": "03 - Tambah laptop",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/laptops",
        "body": {
          "mode": "raw",
          "raw": "{\"nama\":\"Laptop Contoh\",\"merek\":\"Test\",\"deskripsi\":\"Laptop contoh untuk demonstrasi.\",\"harga\":1000000,\"stok\":2}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "04 - Detail laptop",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/laptops/{{laptopId}}"
      }
    },
    {
      "name": "05 - Ubah laptop",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/laptops/{{laptopId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"nama\":\"Laptop Contoh Updated\",\"harga\":1200000}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "06 - Login buyer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"{{registerUsername}}\",\"password\":\"{{registerPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "07 - Beli laptop",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{buyerToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/laptops/{{laptopId}}/buy",
        "body": {
          "mode": "raw",
          "raw": "{\"jumlah\":1,\"metode_pembayaran\":\"qris\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "08 - Hapus laptop",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/laptops/{{laptopId}}"
      }
    }
  ]
}
